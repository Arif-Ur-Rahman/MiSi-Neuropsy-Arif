# Postgres connection string
DATABASE_URL="postgresql://USER@localhost:5432/misi?schema=public"

# Port the API listens on (the frontend's NEXT_PUBLIC_BACKEND_URL must match)
PORT=8000

# Comma-separated origins allowed to call the API
CORS_ORIGINS="http://localhost:3000"

# Credentials for the /admin panel
ADMIN_EMAIL="admin@misineuropsy.nl"
ADMIN_PASSWORD="change-me"

# Secret used to sign admin session cookies
SESSION_SECRET="change-me-to-a-long-random-string"
